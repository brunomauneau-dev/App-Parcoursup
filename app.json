{
  "expo": {
    "name": "Parcours’app",
    "slug": "suivi-voeux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.suivivoeux.prototype"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005D84",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.suivivoeux.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Parcours’app utilise Face ID, si vous l’activez, pour verrouiller l’accès à votre dossier."
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 124,
          "resizeMode": "contain",
          "backgroundColor": "#004C73"
        }
      ]
    ],
    "scheme": "suivivoeux",
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "cde44ae5-d3be-4d7e-bb37-0dda704a55e8"
      }
    },
    "owner": "rivendel",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cde44ae5-d3be-4d7e-bb37-0dda704a55e8",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
