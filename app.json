{
  "expo": {
    "name": "Suivi Vœux",
    "slug": "suivi-voeux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.suivivoeux.prototype"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.suivivoeux.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar"
    ],
    "scheme": "suivivoeux",
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "cde44ae5-d3be-4d7e-bb37-0dda704a55e8"
      }
    },
    "owner": "rivendel",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cde44ae5-d3be-4d7e-bb37-0dda704a55e8"
    }
  }
}
